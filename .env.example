# Copy to .env and fill in. .env is git-ignored.
# Settings solo lee lo que el código usa hoy (slice 1). Más variables llegan
# con sus componentes (webhook/L4, storage/L0, ...).

# --- Anthropic (L0 · ModelProvider) ---
ANTHROPIC_API_KEY=sk-ant-...            # requerida — fail-fast si falta
# Confirmar id de modelo vigente al implementar el ModelProvider (skill claude-api).
ANTHROPIC_MODEL=claude-sonnet-5

# --- Agent core (L2 · reasoning loop) ---
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=16000          # includes thinking tokens

# --- WhatsApp (L4 · edges/whatsapp). Sin estas, el webhook rechaza todo ---
# WHATSAPP_VERIFY_TOKEN=change-me        # el handshake GET de Meta (hub.verify_token)
# WHATSAPP_APP_SECRET=change-me          # firma de webhooks (X-Hub-Signature-256)
# WHATSAPP_ACCESS_TOKEN=change-me        # Bearer para la Graph API
# WHATSAPP_PHONE_NUMBER_ID=              # remitente del bot (= :hook del webhook)
# WHATSAPP_GRAPH_VERSION=v21.0

# --- Storage (L3 · adapters/stores). Sin esto, todo vive en memoria ---
# DATABASE_PATH=agent.db

# --- Langfuse (L3 · adapters/tracing). Sin esto, tracing apagado ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # o us.cloud.langfuse.com

# --- App ---
LOG_LEVEL=INFO
